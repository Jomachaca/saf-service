# Copiar a .env.local y llenar con los valores del proyecto de Supabase
# (Project Settings → API). .env.local está en .gitignore: nunca se commitea.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave pública. En proyectos nuevos Supabase la llama "publishable"
# y empieza con sb_publishable_; en los antiguos es la "anon" y es un JWT.
# Va al navegador: solo puede hacer lo que RLS permita.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta ("service_role" o "secret", sb_secret_...). Se salta RLS.
# Solo servidor. Se usa exclusivamente para resolver /o/{token} — ver
# ARQUITECTURA.md §12 y decisión 7. Nunca la importes desde un componente
# cliente ni la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio, para armar los links que van por WhatsApp.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
